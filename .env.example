# ============================================================
#  .env.example — Template for environment variables
#  ------------------------------------------------------------
#  Copy to .env and fill in real values:
#      cp .env.example .env
#  Never commit your real .env file.
# ============================================================

# ---------- Active Profile ----------
# dev | prod
SPRING_PROFILES_ACTIVE=dev

# ---------- Server ----------
SERVER_PORT=8080

# ---------- Database (MySQL) ----------
# Prod example: jdbc:mysql://prod-db-host:3306/authdb?useSSL=true&requireSSL=true
DB_URL=jdbc:mysql://localhost:3306/authdb?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------- Mail / SMTP ----------
# Dev : sandbox.smtp.mailtrap.io
# Prod: smtp.gmail.com  (or SendGrid / AWS SES / Mailgun)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Universal Auth

# ---------- OAuth2 — Google ----------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=change_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me

# ---------- OAuth2 — GitHub ----------
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# ---------- JWT ----------
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret_min_256_bits
JWT_EXPIRATION=3600000           # 1 hour  (ms)
JWT_REFRESH_EXPIRATION=604800000 # 7 days  (ms)

# ---------- Cookie ----------
# Prod: your actual domain, e.g. .yourdomain.com
COOKIE_DOMAIN=
# true in prod (HTTPS) | false in dev
COOKIE_SECURE=false

# ---------- Frontend / Redirects ----------
FRONTEND_BASE_URL=http://localhost:3000
OAUTH_SUCCESS_REDIRECT=http://localhost:8080/swagger-ui.html

# ---------- Logging ----------
LOG_FILE_PATH=./logs/application.log